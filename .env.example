# --- Core model ---
ANTHROPIC_API_KEY=

# --- Discovery / research connectors ---
EXA_API_KEY=
TAVILY_API_KEY=
# GitHub uses the public API by default; a token raises rate limits (optional).
GITHUB_TOKEN=

# --- Write connectors ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Google Docs + Gmail (server-side OAuth; refresh token minted offline)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Address the weekly recap is sent to (investor mailbox for the demo)
RECAP_TO_EMAIL=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Jobs / infra ---
CRON_SECRET=
DATABASE_URL=

# --- Runtime flags ---
# When "1", connectors resolve from deterministic fixtures instead of live APIs
# (used by the evaluation suite). Anthropic always runs for real in evals.
SCOUT_USE_FIXTURES=0
# Admin token protecting demo-only manual triggers (e.g. forced weekly recap)
ADMIN_TOKEN=
